<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Envios DHL a caminho: o rastreio é consultado a cada 3 horas, até a entrega. -->
    <record id="ir_cron_dhl_refresh_tracking" model="ir.cron">
        <field name="name">DHL Express: atualizar rastreio</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_dhl_refresh_tracking()</field>
        <field name="interval_number">3</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
